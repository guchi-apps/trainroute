// trainroute のデータモデル。
//
// 保存するのは「自分の通勤経路の設定」だけで、駅・路線のマスタは持たない。
// マスタは駅すぱあと API が持っており、複製すると更新（新駅・改称・路線再編）に
// 追従できなくなるため、駅コードと表示用の名称だけを控える。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 登録した通勤経路。
///
/// 利用者は1人の前提のため、所有者はメールアドレスで持つ。認証は Supabase Auth に任せており、
/// このアプリ側にユーザーテーブルを置いていない（複数人で使う必要が出た時点で導入する）。
model CommuteRoute {
  id   String @id @default(cuid())
  /// 所有者。ログインを許可したメールアドレスがそのまま入る。
  userEmail String @db.VarChar(255)
  /// 画面に出す名前（「通勤」「実家」など）。
  name      String @db.VarChar(100)

  /// 駅すぱあとの駅コード。表示名は控えだが、コードが引けなくなったときの手がかりになる。
  originStationCode      String  @db.VarChar(20)
  originStationName      String  @db.VarChar(100)
  destinationStationCode String  @db.VarChar(20)
  destinationStationName String  @db.VarChar(100)
  viaStationCode         String? @db.VarChar(20)
  viaStationName         String? @db.VarChar(100)

  /// 一覧での並び順。小さいものが先。
  sortOrder Int @default(0)

  lines CommuteRouteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userEmail, sortOrder])
}

/// 経路が使う路線。
///
/// **運行情報（遅延）を出す先はここになる。** 現時点で取得元を持っていないため状態は
/// 保存していないが、「どの事業者のどの路線を見ればよいか」はここに揃えてある。
/// 取得元が決まったら、この行に対して状態を引く実装を `src/lib/transit/` に足す。
model CommuteRouteLine {
  id      String       @id @default(cuid())
  routeId String
  route   CommuteRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  /// 事業者名（駅すぱあとの会社名。例: 阪急電鉄）。
  operator String  @db.VarChar(50)
  /// 駅すぱあとの運行路線コード。手入力の場合は null。
  lineCode String? @db.VarChar(20)
  lineName String  @db.VarChar(100)

  sortOrder Int @default(0)

  @@index([routeId, sortOrder])
}

/// 経路検索に使う外部APIの利用枠。**1提供元につき1行を上書きする**（履歴は持たない）。
///
/// 正は提供元が応答ヘッダーで返す残数で、経路検索を呼ぶたびにここへ書き戻す
/// （`src/lib/transit/quota.ts`）。利用枠を読むだけの `GET /api/internal/transit-quota` は
/// 外部APIを叩かずこの行を返す。**残りを確かめる操作そのものが枠を消費しないため。**
model TransitApiQuota {
  /// 提供元の識別子（`navitime` など）。1提供元1行なので、これがそのまま主キー。
  provider String @id @db.VarChar(50)

  /// 枠の上限。提供元が返さない場合は null（残り回数だけを出す）。
  quotaLimit Int?
  /// 残り回数。**これが読めなかった応答では行を作らない**（呼び出し側の必須項目）。
  remaining  Int
  /// 枠が戻る日時。RapidAPI は「残り秒数」で返すため、保存時に日時へ直して入れる。
  /// **暦の月初ではなく契約日からの請求サイクルで戻る**ので、こちらで計算しない。
  resetAt    DateTime?
  /// `provider`（提供元が返した実数） / `local`（trainroute の自前カウントによる概算）。
  source     String    @db.VarChar(20)

  /// 最後に残数を見た時刻。呼び出し側が値の古さを判断するために出す。
  updatedAt DateTime @updatedAt
}
