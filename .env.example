# アプリ実行時に参照する環境変数（値は空。ローカルは .env.local.example を参照）。
# 本番の値は 1Password（apps/trainroute）と organization の共通値が正で、
# GitHub Secrets へは scripts/sync-github-secrets.sh で同期する。
# 対応表は .github/secrets-manifest.tsv。

DATABASE_URL=

# Supabase Auth（Google）。他アプリと共有の Supabase プロジェクトを使う。
# publishable key はブラウザへ配られる公開値。service_role キーはこのアプリでは扱わない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログインを許可するメールアドレス（カンマ区切り）。未設定なら誰もログインできない。
# Supabase プロジェクトは共用のため、Supabase でログインできること自体は許可を意味しない。
ALLOWED_EMAIL=

# 本番URL。アプリからは参照しないが、Supabase の Redirect URLs 登録と
# Apache VirtualHost の生成で使う本番URLの正として持つ。
AUTH_URL=

# 駅すぱあと API（フリープラン）。契約ドメインは trainroute.gucchii.com。
EKISPERT_ACCESS_KEY=

# NAVITIME API（RapidAPI経由）。経路の所要時間を返す /api/internal/route-transit だけが使う。
# 無料枠は月500回のハードリミット。未設定ならそのAPIが 503 を返す（他の機能は動く）。
NAVITIME_API_KEY=

# AIDE から /api/internal/* を叩くための共有シークレット。
# 未設定なら /api/internal/* は 503 を返す（認証なしの公開にはならない）。
INTERNAL_API_KEY=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
