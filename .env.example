# アプリ実行時に参照する環境変数（値は空。ローカルは .env.local.example を参照）。
# 本番の値は 1Password（apps/trainroute）が正で、GitHub Secrets へは
# scripts/sync-github-secrets.sh で同期する。対応表は .github/secrets-manifest.tsv。

DATABASE_URL=

# NextAuth v5（Google）
AUTH_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ログインを許可するメールアドレス（カンマ区切り）。未設定なら誰もログインできない。
ALLOWED_EMAIL=

# 駅すぱあと API（フリープラン）。契約ドメインは trainroute.gucchii.com。
EKISPERT_ACCESS_KEY=

# AIDE から /api/internal/* を叩くための共有シークレット。
# 未設定なら /api/internal/* は 503 を返す（認証なしの公開にはならない）。
INTERNAL_API_KEY=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
