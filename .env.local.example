# ローカル開発用のひな形。`cp .env.local.example .env.local` して各自の値を書く。
# .env.local は git 管理外（このリポジトリは公開しているので、実値を絶対にコミットしない）。

# ローカルの MariaDB / MySQL。DB名は本番と揃えておくと移行時に迷わない。
DATABASE_URL="mysql://root:password@127.0.0.1:3306/app_trainroute"

# NextAuth v5
AUTH_URL="http://localhost:3000"
# openssl rand -base64 32 などで生成する
AUTH_SECRET=""

# **本番とは別に作った開発用の Google OAuth クライアント**を使う。
# 承認済みリダイレクトURI: http://localhost:3000/api/auth/callback/google
# （本番用クライアントの認証情報はここに書かない。1Password が正）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 自分のメールアドレス
ALLOWED_EMAIL=""

# 駅すぱあとのアクセスキー。未設定でも起動するが、駅検索が 503 になる。
EKISPERT_ACCESS_KEY=""

# AIDE連携をローカルで試す場合のみ。本番の値は使わない。
INTERNAL_API_KEY=""
