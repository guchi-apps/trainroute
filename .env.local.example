# ローカル開発用のひな形。`cp .env.local.example .env.local` して各自の値を書く。
# .env.local は git 管理外（このリポジトリは公開しているので、実値を絶対にコミットしない）。

# ローカルの MariaDB / MySQL。DB名は本番と揃えておくと移行時に迷わない。
DATABASE_URL="mysql://root:password@127.0.0.1:3306/app_trainroute"

# 他アプリと共有の Supabase プロジェクト（本番と同じ値でよい。どちらも公開値）。
# Supabase の Authentication > URL Configuration > Redirect URLs に
# http://localhost:3000/auth/callback を登録しておく。
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 自分のメールアドレス
ALLOWED_EMAIL=""

AUTH_URL="http://localhost:3000"

# 駅すぱあとのアクセスキー。未設定でも起動するが、駅検索が 503 になる。
EKISPERT_ACCESS_KEY=""

# NAVITIME（RapidAPI）のアクセスキー。未設定でも起動するが、
# /api/internal/route-transit が 503 になる。**無料枠は月500回のハードリミットで、
# 本番と同じキーを使うと本番の枠を削る。** 試すときは呼ぶ回数を数えること。
NAVITIME_API_KEY=""

# AIDE連携をローカルで試す場合のみ。本番の値は使わない。
INTERNAL_API_KEY=""

# GUIが無い環境（SSH越しのtmux等）で画面確認をするときだけ true にする。
# ALLOWED_EMAIL の先頭のアドレスでログイン済み扱いになる。
# **本番（NODE_ENV=production）では常に無効。**
# DISABLE_AUTH=true
